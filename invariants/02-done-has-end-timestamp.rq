# 02 — done-has-end-timestamp.rq
#
# What:   ems__Task in Done status must carry an ems__Effort_endTimestamp of
#         datatype xsd:dateTime.
# Why:    Done without an endTimestamp breaks productivity roll-ups; a bare
#         "null" literal would slip past a plain EXISTS check, hence the
#         DATATYPE filter.
# Output: ?task  — subject IRI / UUID
#         ?issue — human-readable message for the GHA annotation
# Notes:  Done status matched via ns URI or UUID-file-IRI suffix (same
#         CLI-vs-plugin divergence rationale as 01).

PREFIX exo: <https://exocortex.my/ontology/exo#>
PREFIX ems: <https://exocortex.my/ontology/ems#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?task ?issue WHERE {
  ?task exo:Instance_class ?class .
  FILTER(
    STR(?class) = "https://exocortex.my/ontology/ems#Task"
    || STRENDS(STR(?class), "|ems__Task]]")
  )
  ?task ems:Effort_status ?status .
  FILTER(
    STR(?status) = "https://exocortex.my/ontology/ems#EffortStatusDone"
    || STRENDS(STR(?status), "7b9b3116-7c3c-438c-9618-94fe301320a6.md")
  )
  FILTER NOT EXISTS {
    ?task ems:Effort_endTimestamp ?end .
    FILTER(DATATYPE(?end) = xsd:dateTime)
  }
  BIND("Done task missing xsd:dateTime Effort_endTimestamp" AS ?issue)
}
